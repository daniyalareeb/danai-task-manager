# OpenRouter API Key (Required for AI features)
# Get your free key from: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_key_here

# Database URL (Optional - currently using in-memory storage)
# Choose one option below:

# Option 1: PostgreSQL (Recommended - this project uses PostgreSQL)
# Get free PostgreSQL from:
# - Neon: https://neon.tech (recommended)
# - Supabase: https://supabase.com
# - Railway: https://railway.app
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Option 2: MongoDB (if you prefer MongoDB)
# Get free MongoDB from: https://www.mongodb.com/cloud/atlas
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname

# Server Port (default: 5000)
PORT=5000
